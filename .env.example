# LLM 提供商：ecnu 或 local
# ecnu: 使用华东师范大学 API（需要 ECNU_API_KEY）
# local: 使用本地部署的 Qwen/vLLM/Ollama/LM Studio（OpenAI 兼容 API）
LLM_PROVIDER=ecnu

# ECNU API 配置（LLM_PROVIDER=ecnu 时必填）
ECNU_API_KEY=your_api_key_here

# 本地 LLM 配置（LLM_PROVIDER=local 时使用）
# 注意：项目后端默认占用 8000，本地模型服务建议使用 8001
# LOCAL_LLM_BASE_URL=http://localhost:8001/v1
# LOCAL_LLM_MODEL=qwen2.5-7b-instruct
# LOCAL_LLM_API_KEY=not-needed

# 向量数据库类型：chroma 或 postgres
# 本地开发使用 chroma，生产环境使用 postgres
VECTOR_STORE_TYPE=chroma

# Memory 存储类型：memory, postgres, hybrid
# memory: 内存存储（开发环境，重启丢失）
# postgres: PostgreSQL 持久化（生产环境）
# hybrid: PostgreSQL + Redis（推荐，性能最佳）
MEMORY_STORE_TYPE=memory

# PostgreSQL 配置（使用 postgres 时必填）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_research_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# Redis 配置（使用 hybrid 时必填）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
